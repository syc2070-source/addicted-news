:root {
  --color-bg: #f3f6fb;
  --color-surface: #ffffff;
  --color-primary: #2463c7;
  --color-primary-soft: #e0edff;
  --color-accent: #f97316;
  --color-text-main: #111827;
  --color-text-muted: #6b7280;
  --color-border: #d1d5db;
  --radius-lg: 16px;
  --radius-pill: 999px;
  --shadow-soft: 0 10px 30px rgba(15, 23, 42, 0.12);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  background: var(--color-bg);
  color: var(--color-text-main);
}

a { color: inherit; text-decoration: none; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

header {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(14px);
  background: linear-gradient(
    to bottom,
    rgba(243, 246, 251, 0.92),
    rgba(243, 246, 251, 0.8)
  );
  border-bottom: 1px solid rgba(209, 213, 219, 0.7);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-logo {
  width: 40px;
  height: 40px;
  border-radius: 14px;
  background: radial-gradient(circle at 20% 0%, #e5e7eb, #1f2937);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 8px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.7);
}

.logo-a,
.logo-n {
  font-weight: 800;
  font-size: 15px;
  letter-spacing: -0.04em;
  line-height: 1;
}

.logo-a {
  color: #fbbf24;
  position: relative;
  padding-right: 7px;
  margin-right: 7px;
}

.logo-a::after {
  content: "";
  position: absolute;
  right: 0;
  top: 15%;
  bottom: 15%;
  width: 1px;
  background: rgba(148, 163, 184, 0.9);
}

.logo-n { color: #e5e7eb; }

.brand-text-title {
  font-size: 18px;
  font-weight: 700;
}

.brand-text-sub {
  font-size: 12px;
  color: var(--color-text-muted);
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
}

.nav-item {
  padding: 6px 12px;
  border-radius: var(--radius-pill);
  color: var(--color-text-muted);
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.15s ease;
}

.nav-item:hover { background: rgba(37, 99, 235, 0.08); }

.nav-item.active {
  background: var(--color-primary);
  color: white;
  border-color: rgba(37, 99, 235, 0.6);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
}

.main-wrap {
  flex: 1;
  max-width: 1280px;
  margin: 16px auto 40px;
  padding: 0 20px 20px;
  display: grid;
  grid-template-columns: minmax(0, 2.5fr) 320px;
  gap: 20px;
}

@media (max-width: 880px) {
  .main-wrap { grid-template-columns: minmax(0, 1fr); }
  .nav-menu { display: none; }
}

.top-panel {
  grid-column: 1 / -1;
  margin-bottom: 8px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
  border: 1px solid rgba(209, 213, 219, 0.7);
}

.search-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 14px;
  background: transparent;
}

.search-icon {
  font-size: 16px;
  color: var(--color-text-muted);
}

.category-tabs {
  margin-top: 12px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.category-tab {
  padding: 6px 12px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-border);
  font-size: 13px;
  color: var(--color-text-muted);
  background: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  transition: all 0.12s ease;
}

.category-tab:hover { border-color: var(--color-primary); }

.category-tab.active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

/* 탑뉴스 + 기획기사 */

.top-highlights {
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.6fr);
  gap: 12px;
  margin-top: 10px;
  margin-bottom: 12px;
}

@media (max-width: 880px) {
  .top-highlights { grid-template-columns: minmax(0, 1fr); }
}

.top-news-card,
.feature-card {
  background: linear-gradient(135deg, #eef2ff, #f9fafb);
  border-radius: var(--radius-lg);
  padding: 12px 14px;
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.10);
  border: 1px solid rgba(209, 213, 219, 0.8);
}

.top-label {
  display: inline-block;
  font-size: 13px;
  font-weight: 800;
  color: #ffffff;
  background: #1d4ed8;
  padding: 4px 11px;
  border-radius: 999px;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.top-title {
  font-size: 16px;
  font-weight: 800;
  margin-bottom: 4px;
}

.top-meta {
  font-size: 11px;
  color: var(--color-text-muted);
  margin-bottom: 6px;
}

.top-teaser {
  font-size: 13px;
  color: var(--color-text-muted);
  margin-bottom: 6px;
}

.top-link {
  font-size: 12px;
  color: var(--color-primary);
  cursor: pointer;
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.feature-item {
  padding: 6px 0;
  border-bottom: 1px dashed #e5e7eb;
  cursor: pointer;
}

.feature-item:last-child { border-bottom: none; }

.feature-title {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 2px;
}

.feature-meta {
  font-size: 11px;
  color: var(--color-text-muted);
}

.feature-empty {
  font-size: 12px;
  color: var(--color-text-muted);
}

/* 오른쪽: 오늘의 주요 이슈 */

.hot-sidebar {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 14px 14px 12px;
  box-shadow: var(--shadow-soft);
  border: 1px solid rgba(209, 213, 219, 0.75);
}

.card-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
}

.hot-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.hot-card {
  border-radius: 14px;
  padding: 10px 10px 9px;
  border: 1px solid rgba(209, 213, 219, 0.9);
  background: #f9fafb;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.12s ease;
}

.hot-card:hover {
  background: #eef3ff;
  border-color: var(--color-primary);
}

.hot-tagline {
  font-size: 11px;
  color: var(--color-text-muted);
  margin-bottom: 3px;
}

.hot-title {
  font-weight: 600;
  margin-bottom: 3px;
}

.hot-meta {
  font-size: 11px;
  color: var(--color-text-muted);
}

.hot-more {
  margin-top: 6px;
  font-size: 11px;
  color: var(--color-primary);
}

/* 기사 리스트 */

.articles-wrap {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.articles-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 2px;
  margin-top: 4px;
}

.articles-title {
  font-size: 15px;
  font-weight: 600;
}

.articles-meta {
  font-size: 12px;
  color: var(--color-text-muted);
}

.article-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 12px 14px;
  border: 1px solid rgba(209, 213, 219, 0.9);
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.07);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.article-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
}

.badge-category {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 600;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--color-primary);
}

.article-time {
  font-size: 11px;
  color: var(--color-text-muted);
}

.article-title {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
}

.article-sub {
  font-size: 13px;
  color: var(--color-text-muted);
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 2px;
}

.tag {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 999px;
  background: #f3f4f6;
  color: #4b5563;
}

.article-actions {
  display: flex;
  justify-content: flex-start;
  gap: 8px;
  margin-top: 4px;
}

.btn {
  font-size: 12px;
  padding: 5px 10px;
  border-radius: 999px;
  border: 1px solid var(--color-border);
  background: #f9fafb;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: all 0.12s ease;
}

.btn:hover {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.btn-primary {
  background: var(--color-primary);
  color: white;
  border-color: var(--color-primary);
}

.btn-primary:hover { background: #1e40af; }

.summary {
  margin-top: 6px;
  padding: 8px 10px;
  border-radius: 10px;
  background: #f9fafb;
  border: 1px dashed #e5e7eb;
  font-size: 13px;
  color: #374151;
  line-height: 1.5;
}

.load-more-wrap {
  margin-top: 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.load-more-text {
  font-size: 11px;
  color: var(--color-text-muted);
  text-align: center;
}

footer {
  border-top: 1px solid #e5e7eb;
  padding: 18px 20px 26px;
  font-size: 12px;
  color: var(--color-text-muted);
  text-align: center;
}

@media (max-width: 640px) {
  .header-inner { padding: 10px 14px; }
  .main-wrap { padding: 0 14px 18px; }
  .card { padding: 12px 12px 10px; }
  .article-card { padding: 10px 12px; }
}

/* 검색 자동완성 박스 */

.autocomplete-wrap {
  margin-top: 6px;
  background: var(--color-surface);
  border-radius: 12px;
  border: 1px solid rgba(209, 213, 219, 0.9);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
  max-height: 260px;
  overflow-y: auto;
  font-size: 13px;
  display: none;
}

.autocomplete-item {
  padding: 7px 10px;
  cursor: pointer;
  border-bottom: 1px solid #f3f4f6;
}

.autocomplete-item:last-child {
  border-bottom: none;
}

.autocomplete-item:hover {
  background: #eef2ff;
}

.autocomplete-title {
  font-weight: 500;
  margin-bottom: 2px;
}

.autocomplete-meta {
  font-size: 11px;
  color: var(--color-text-muted);
}
